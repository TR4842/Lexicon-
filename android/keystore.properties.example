# Copy to android/keystore.properties and fill in (that file is git-ignored).
# The SAME keystore must sign every release: Android only installs a new APK
# over an existing one when the applicationId and the signing certificate match.
#
# Create one with:
#   keytool -genkeypair -v -keystore release.keystore -alias vocab-ledger \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# In GitHub Actions the same values come from secrets instead:
#   ANDROID_KEYSTORE_BASE64   base64 -w0 release.keystore
#   ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

# path is relative to the android/ folder
storeFile=release.keystore
storePassword=changeme
keyAlias=vocab-ledger
keyPassword=changeme
