{
  "appId": "com.tusherkhan.vocabledger",
  "appName": "Vocab Ledger",
  "webDir": "app",
  "backgroundColor": "#FFF6EA",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#FFF6EA",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#FFF6EA",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FFF6EA"
    }
  }
}
